# Copy to .env, or run `python scripts/setup_local.py` to generate one with random secrets.
KC_ENVIRONMENT=development
POSTGRES_PASSWORD=change-me
KC_SECRET_KEY=generate-a-long-random-value
KC_MEDIA_WORKER_TOKEN=generate-a-long-random-value
KC_GPU_WORKER_TOKEN=generate-a-long-random-value
KC_BOOTSTRAP_WORKERS=media-docker:<KC_MEDIA_WORKER_TOKEN>:media,stt;gpu-desktop:<KC_GPU_WORKER_TOKEN>:llm,image
KC_MEDIA_WORKERS=4

# AI providers
SARVAM_API_KEY=
KC_LLM_BASE_URL=http://localhost:1234/v1
KC_LLM_MODEL=qwen/qwen3-8b
KC_ARTWORK_PROVIDER=pollinations

# Production (the Lightsail server writes these with: python3 scripts/setup_local.py --server app.kathachepta.com)
KC_STAFF_MFA_REQUIRED=false
KC_COOKIE_SECURE=false
KC_PUBLIC_BASE_URL=http://localhost:8080
# Email sign-in codes, email confirmation and narrator notices. false: username and password only, nothing is sent.
# true here uses Mailpit (http://localhost:8025); on the server it needs SMTP credentials (Amazon SES or Zoho).
KC_EMAIL_ENABLED=false
# Continue with Google (web): a Google Cloud OAuth web client. Off while empty (docs/lightsail-pilot.md).
KC_GOOGLE_CLIENT_ID=
KC_GOOGLE_CLIENT_SECRET=
KC_SMTP_HOST=mailpit
KC_SMTP_PORT=1025
KC_SMTP_USERNAME=
KC_SMTP_PASSWORD=

# Desktop only: the Lightsail server (scripts/lightsail.ps1) and pointing the GPU worker at it
KC_SERVER_HOST=
KC_SERVER_SSH_KEY=
KC_GPU_API_URL=
KC_GPU_API_TOKEN=
# When the evening task (npm run worker:gpu:schedule) may use the GPU, on this PC's clock
KC_GPU_HOURS=19:00-06:00
