{
  "expo": {
    "name": "KathaChepta",
    "slug": "kathachepta",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kathachepta",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F6F1",
    "ios": {
      "bundleIdentifier": "com.kathachepta.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kathachepta.app",
      "adaptiveIcon": {
        "backgroundColor": "#2A1C10",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "KathaChepta",
      "shortName": "KathaChepta",
      "themeColor": "#315747",
      "backgroundColor": "#F7F6F1",
      "lang": "te"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2A1C10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "384cf672-96a9-45d4-afc0-e6452760adcf"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/384cf672-96a9-45d4-afc0-e6452760adcf"
    }
  }
}
